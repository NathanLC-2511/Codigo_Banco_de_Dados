DROP TABLE OFERTAS;
DROP TABLE ALUNOS_OFERTAS;
DROP TABLE TELEFONES;
DROP TABLE PROFESSORES;
DROP TABLE ALUNOS;
CREATE TABLE ALUNOS(
	MATRICULA NUMBER NOT NULL,
	NOME VARCHAR2(100) NOT NULL,
	DATA_NASCIMENTO DATE NOT NULL
);

CREATE TABLE PROFESSORES(
	MATRICULA NUMBER NOT NULL,
	NOME VARCHAR2(100) NOT NULL,
	FORMACAO VARCHAR2(100) NOT NULL 
);

CREATE TABLE TELEFONES(
	TELEFONE VARCHAR2(11) NOT NULL,
	MATRICULA NUMBER NOT NULL
);

CREATE TABLE OFERTAS(
	CODIGO_OFERTAS NUMBER NOT NULL,
	HORA_INICIAL TIME NOT NULL,
	HORA_FINAL TIME NOT NULL,
	DIA_SEMANA VARCHAR2(20) NOT NULL,
	MATRICULA NUMBER(5) NOT NULL,
	CODIGO_DICIPLINA NUMBER NOT NULL
);

CREATE TABLE ALUNOS_OFERTAS(
	MATRICULA NUMBER NOT NULL,
	CONDIGO_OFERTA NUMBER NOT NULL,
	LIMITE_ALUNOS NUMBER NOT NULL,
	SEMESTRE VARCHAR2(6) NOT NULL,
	DATA_INICIAL DATE NOT NULL,
	DATA_FINAL DATE NOT NULL 
);

CREATE TABLE DICIPLINAS(
	CODIGO_DICIPLINA VARCHAR2 NOT NULL;
	NOME_DICIPLINAS VARCHAR2(100) NOT NULL;
	CARGA_HORARIA NUMBER(3) NOT NULL;
	EMENTA VARCHAR2(4000) NOT NULL;
	CODIGO_DICIPLINA_DEPENDECIA NUMBER NOT NULL;
);


